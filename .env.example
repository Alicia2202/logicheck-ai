# Copia este archivo como .env (no se sube a git) o define las variables
# en Vercel: Project Settings -> Environment Variables.

# Proveedor del extractor para PDFs/imágenes: gemini (por defecto) o claude.
LOGICHECK_LLM=gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Solo si LOGICHECK_LLM=claude
ANTHROPIC_API_KEY=
